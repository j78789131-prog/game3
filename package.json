{
  "name": "skybound-flight-simulator",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"node server/index.js\" \"expo start --web\"",
    "web": "expo start --web",
    "android": "expo start --android",
    "export:web": "expo export --platform web",
    "build:android": "eas build --platform android --profile preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo": "~54.0.0",
    "expo-av": "~16.0.7",
    "expo-image-picker": "~17.0.1",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2"
  }
}